        {
          "zh": "和家长一起观察圆形与方形。",
          "en": "Notice circles and squares together."
        },
        {
          "zh": "一起点数两个圆形。",
          "en": "Count two circles together."
        }
      ],
      "cover": {
        "concept": "hello.circle",
        "image": "assets/images/shapes/circle.svg",
