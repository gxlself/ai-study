        "lessonsPerDay": 1,
        "coView": "required",
        "childScreen": "default"
      },
      "themes": [
        {
          "id": "hello.shapes",
          "title": {
            "zh": "圆圆方方",
            "en": "Circles and Squares"
          },
          "weeks": 1,
          "domains": ["cognition", "math"],
          "lessons": ["hello.s1.shapes"],
          "offlineFocus": ["到生活中观察圆形与方形，不要求宝宝记住名称。"]
