  "cover": {"concept": "panda", "bg": "forest"},
  "parentGuide": {
    "intro": "每页停一停，宝宝说“吃”，你接“熊猫吃竹子”。熊猫会吃竹子、爬树，也会休息。竹子暂无专用词条，只在文字中说；图里的树和草是环境，不指成竹子。宝宝不模仿爬高。",
    "tips": ["优先问“熊猫在哪里”“在做什么”。", "只问一题，回应后扩成短句，不逼复述。", "读完关屏，用玩偶在地面演吃和休息。"],
    "phrases": [
      {"zh": "熊猫在吃竹子。", "en": "The panda is eating bamboo."},
      {"zh": "它会爬树。", "en": "It can climb trees."},
      {"zh": "它在地上休息。", "en": "It is resting on the ground."},
      {"zh": "你看见它在做什么？", "en": "What do you see it doing?"}
    ],
    "why": "对话式阅读让宝宝参与指认、命名和短句扩展。只写已核实的动物行为，不把一天的故事当作固定作息或训练宝宝攀爬。",
    "refs": ["[44]", "[48]", "[49]", "[82]"]
  },
  "offline": [{
    "title": "玩偶吃一口，歇一歇",
    "minutes": 8,
    "materials": ["完整大玩偶", "幼儿动物纸书", "地垫"],
    "steps": ["找书中的熊猫，指一指它。", "空手假装玩偶吃竹子，不向嘴里塞东西。", "把玩偶放在地垫上，轻声说“休息了”。", "请宝宝选吃或休息，大人用一句话接住。"],
    "safety": "成人陪同。玩偶无松动眼睛、纽扣或小配件；直径小于3.5厘米的小物件有窒息风险。不拿真竹枝、筷子或食物塞进玩偶或宝宝嘴里。不爬树、椅子、桌子或柜子，只在地面假装。",
    "domains": ["science", "language"],
    "question": "你想让玩偶接下来做什么？",
    "levels": {"easier": "宝宝指书，大人说“吃”或“睡”。", "harder": "宝宝摆玩偶并说一两个词，大人扩成“熊猫在休息”。"}
  }],
