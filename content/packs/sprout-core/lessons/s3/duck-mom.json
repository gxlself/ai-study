  "parentGuide": {
    "intro": "先读完，再关屏。一张鸭卡当小鸭。另一张当鸭妈妈。其他动物来问好。这是假装故事。家长和鸭妈妈一直在旁。不演走失，不让宝宝害怕。",
    "tips": [
      "声音可以有变化，但节奏要慢。",
      "跟着宝宝的目光拿卡。保持舒服距离。",
      "把“妈妈在这里”说得安心、稳定。"
    ],
    "phrases": [
      {
        "zh": "小鸭子找妈妈。",
        "en": "The duck looks for mama."
      },
      {
        "zh": "是妈妈吗？",
        "en": "Is that mama?"
      },
      {
        "zh": "这是母鸡。",
        "en": "This is a hen."
      },
      {
        "zh": "鸭妈妈在这里。",
        "en": "Duck mama is here."
      }
    ],
    "why": "低月龄重在命名和回应。看一眼或指一下也参与。不要求解释情节。阅读证据以更大儿童为主。",
    "refs": ["[48]", "[82]"]
  },
  "offline": [
    {
      "title": "小鸭子找一找",
      "minutes": 5,
      "materials": ["两张鸭卡", "母鸡、奶牛和小狗卡"],
      "steps": [
        "把一张鸭卡当妈妈。另一张当小鸭。成人拿持。",
        "拿母鸡、奶牛和小狗卡。依次和小鸭问好。",
        "问一次“是妈妈吗？”随后说动物名字。",
        "让两张鸭卡靠近。说“鸭妈妈在这里”。"
      ],
      "safety": "这是温和的假装游戏。成人始终在宝宝身边。鸭妈妈也一直在旁。大卡完整，边缘平整。防止咬碎入口。不制造分离或害怕。",
      "domains": ["language", "social"],
      "question": "你想怎样和小鸭打招呼？",
      "levels": {
        "easier": "只用两张鸭卡。演妈妈和小鸭相遇。",
        "harder": "加入一张动物卡。停下来等宝宝挥手或发声。"
      }
    }
  ],
  "steps": [
    {
      "type": "guide",
      "parentTip": "故事给家长看。讲完就放下屏幕。",
      "props": {
        "goal": "用动物卡讲短故事。等宝宝参与。",
        "materials": ["两张鸭卡", "母鸡、奶牛和小狗卡"],
        "steps": [
          {
            "text": "把一张鸭卡放在旁边。它扮鸭妈妈。",
            "concept": "duck",
            "say": {
              "zh": "鸭妈妈在这里。",
              "en": "Duck mama is here."
            }
          },
          {
            "text": "拿另一张鸭卡当小鸭。慢慢走向母鸡卡。",
            "concept": "duck",
            "say": {
              "zh": "小鸭子找妈妈。",
              "en": "The duck looks for mama."
            }
          },
          {
            "text": "举起母鸡卡。问一次再命名。",
            "concept": "chicken",
            "say": {
              "zh": "是妈妈吗？这是母鸡。",
              "en": "Is that mama? This is a hen."
            }
          },
          {
            "text": "举起奶牛卡。让奶牛轻声问好。",
            "concept": "cow",
            "say": {
              "zh": "奶牛，哞哞。",
              "en": "Cow, moo moo."
            }
          },
          {
            "text": "举起小狗卡。让小狗轻声问好。",
            "concept": "dog",
            "say": {
              "zh": "小狗，汪汪。",
              "en": "Dog, woof woof."
            }
          },
          {
            "text": "把两张鸭卡靠近。讲完故事。",
            "concept": "duck",
            "say": {
              "zh": "鸭妈妈在这里。",
              "en": "Duck mama is here."
            }
          }
        ],
        "playMin": 5,
        "observe": [
          "是否跟着卡片或声音看。",
          "是否在提问后停下来等待。",
          "是否用表情、动作或声音参与。"
        ],
        "safety": "成人全程陪伴。语气温和。不演分离和走失。宝宝不安就停。先安抚，再决定是否继续。卡片边缘平整，防入口。"
      }
    }
  ]
}
