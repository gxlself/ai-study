{
  "schemaVersion": 1,
  "id": "core.s3.body-parts",
  "title": {
    "zh": "我的身体",
    "en": "My Body"
  },
  "summary": {
    "zh": "穿衣时慢慢说。找一找身体部位。",
    "en": "Name body parts slowly during bathing and dressing."
  },
  "ageRange": [12, 17],
  "domains": ["language", "science"],
  "themeId": "s3-t2",
  "tags": ["first-words", "body-awareness"],
  "durationMin": 2,
  "coView": "required",
  "audience": "parent",
  "printables": [
    {
      "kind": "cards",
      "title": "身体部位大卡",
      "items": ["eye", "ear", "nose", "mouth", "hand", "foot"],
      "size": "large",
      "showText": true,
      "showEnglish": true
    }
  ],
  "objectives": [
    {
      "zh": "听熟悉的身体词。",
      "en": "Hear familiar body words."
    },
    {
      "zh": "用眼神、手势或动作回应。",
      "en": "Respond with a look, gesture, or movement."
    }
  ],
  "cover": {
    "concept": "nose",
    "bg": "paper"
  },
  "parentGuide": {
    "intro": "先读完，再关屏。首选地垫上穿衣时。拿大卡指自己的部位。再邀请宝宝看或指。一天只选一两处。宝宝不愿碰时只听。洗澡时不拿卡和手机。",
    "tips": [
      "先说真实词，再加一个短句。",
      "轻触前先让宝宝看见你的手。",
      "不要求答对。以下动作可轮换。当天只选一两处。"
    ],
    "phrases": [
      {
        "zh": "鼻子在哪里？",
        "en": "Where is your nose?"
      },
      {
        "zh": "这是你的鼻子。",
        "en": "This is your nose."
      },
      {
        "zh": "这是我的手。",
        "en": "This is my hand."
      },
      {
        "zh": "你想摸一摸吗？",
        "en": "Would you like to touch?"
      }
    ],
    "why": "真实照护提供说话机会。研究支持儿向语言和回应。看和指也是交流。不强迫触摸或复述。",
    "refs": ["[6]", "[45]", "[47]", "[59]"]
  },
  "offline": [
    {
      "title": "穿衣时找身体",
      "minutes": 5,
      "materials": ["身体部位大卡"],
      "steps": [
        "坐在防滑地垫上。拿鼻子卡指自己的鼻子。",
        "穿衣时问一个部位。等宝宝看或指。",
        "宝宝愿意时找手和脚。成人只指，不戳五官。",
        "轮换眼睛、耳朵和嘴卡。一天只选一两处。"
      ],
      "safety": "不戳眼睛、鼻孔和嘴。不要求用手碰五官。触摸身体先征询。宝宝转开就停止。不拉扯四肢。若洗澡时命名。先把设备和卡收好。水边全程看护。片刻也不离开。",
      "domains": ["language", "science"],
      "question": "你的小手还想做什么？",
      "levels": {
        "easier": "只说一个部位。家长先指自己的身体。",
        "harder": "双方轮流指一个部位。宝宝只看也好。"
      }
    }
  ],
  "steps": [
    {
      "type": "guide",
      "parentTip": "先指自己，再邀请宝宝回应。",
      "props": {
        "goal": "在照护中听身体部位词。",
        "materials": ["身体部位打印卡"],
        "steps": [
          {
            "text": "拿眼睛卡。指家长的眼睛。只指，不碰。",
            "concept": "eye",
            "say": {
              "zh": "这是我的眼睛。",
              "en": "This is my eye."
            }
          },
          {
            "text": "换拿耳朵卡给宝宝看。慢慢说名字。",
            "concept": "ear",
            "say": {
              "zh": "耳朵可以听。",
              "en": "Ears can hear."
            }
          },
          {
            "text": "问宝宝一个部位在哪里。停五秒等回应。",
            "concept": "nose",
            "say": {
              "zh": "鼻子在哪里？",
              "en": "Where is your nose?"
            }
          },
          {
            "text": "拿嘴巴卡。指自己的嘴。宝宝只看也好。",
            "concept": "mouth",
            "say": {
              "zh": "这是我的嘴巴。",
              "en": "This is my mouth."
            }
          },
          {
            "text": "宝宝愿意时找手和脚。轮换用对应大卡。",
            "concept": "hand",
            "say": {
              "zh": "小手挥一挥。",
              "en": "Wave your little hand."
            }
          }
        ],
        "playMin": 5,
        "observe": [
          "是否看向被说出的部位。",
          "是否用手势、触摸或声音回应。",
          "是否在被尊重时愿意继续。"
        ],
        "safety": "只做宝宝愿意的触摸。宝宝转开就停。不戳眼睛、鼻孔或嘴。不拉四肢。卡片由成人拿住。水边不拿卡和设备。片刻也不离开宝宝。"
      }
    }
  ]
}
