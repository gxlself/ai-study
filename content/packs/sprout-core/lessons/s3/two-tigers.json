  "audience": "parent",
  "objectives": [
    {
      "zh": "听重复的歌声。",
      "en": "Your baby hears a repeated melody."
    },
    {
      "zh": "用看、拍手或发声参与。",
      "en": "Your baby joins with a look, clap, or sound."
    }
  ],
  "cover": {
    "concept": "tiger",
    "bg": "grass"
  },
  "parentGuide": {
    "intro": "先由家长单独学唱。关屏后面对面唱。中文换成温和原创词。两只老虎慢慢走。不唱身体残缺很奇怪。宝宝看、笑或轻轻动都好。",
    "tips": [
      "不使用吓人的老虎叫声。",
      "每句唱完停一停，等宝宝反应。",
      "宝宝不想拍手时。家长自己做即可。"
    ],
    "phrases": [
      {
        "zh": "两只老虎。",
        "en": "Two little tigers."
      },
      {
        "zh": "慢慢走。",
        "en": "Walk slowly."
      },
      {
        "zh": "和宝宝一起唱。",
        "en": "Let's sing together."
      },
      {
        "zh": "休息一下吧。",
        "en": "Let's take a break."
      }
    ],
    "why": "真人一起唱，能留出交流。主动音乐研究支持亲子参与。不等于本课已证明有效。不用歌曲测试数量。",
    "refs": ["[82]", "[87]"]
  },
  "offline": [
    {
      "title": "膝上慢唱",
      "minutes": 8,
      "materials": ["成人稳固的椅子或软垫"],
      "steps": [
        "家长坐稳。宝宝舒适地坐在身边。不必坐成人腿上。",
        "先唱一段。只做轻轻拍腿或拍手。",
        "唱完停下来。观察宝宝是否看你、笑或发声。",
        "宝宝愿意时再唱一遍。不想继续就结束。"
      ],
      "safety": "成人保持坐稳。不快速摇晃、抛接或抱着转圈。不强迫宝宝拍手。不使用高音量或惊吓音效。",
      "domains": ["music", "english"],
      "question": "你想再听哪一句？",
      "levels": {
        "easier": "只唱开头两句。宝宝看你就好。",
        "harder": "唱完一段再停顿。等宝宝用动作回应。"
      }
    }
  ],
  "steps": [
    {
      "type": "guide",
      "parentTip": "慢唱、轻动作，宝宝不必跟唱。",
