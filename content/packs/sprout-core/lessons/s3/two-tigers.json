    "zh": "两只老虎",
    "en": "Two Tigers"
  },
  "summary": {
    "zh": "慢慢唱熟悉旋律。一起轻轻拍拍手。",
    "en": "Sing the familiar melody slowly with gentle shared movements."
  },
  "ageRange": [12, 17],
  "domains": ["music", "english"],
  "themeId": "s3-t4",
  "tags": ["song", "rhythm"],
