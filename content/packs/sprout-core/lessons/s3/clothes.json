  "parentGuide": {
    "intro": "先读完，再关屏。穿衣前拿大卡配实物。一天只说一两件。穿衣时把卡收好。等宝宝伸手或抬脚。可给两件合适上衣选。不强迫，也不急。",
    "tips": [
      "边穿边说，不需要额外训练。",
      "先给宝宝看衣物，再穿上。",
      "不必完成选择。衣物合适、舒服更重要。"
    ],
    "phrases": [
      {
        "zh": "这是上衣。",
        "en": "This is a shirt."
      },
      {
        "zh": "你想穿帽子吗？",
        "en": "Would you like the hat?"
      },
      {
        "zh": "小脚抬起来。",
        "en": "Lift your little foot."
      },
      {
        "zh": "穿好啦。",
        "en": "All dressed."
      }
    ],
    "why": "生活常规提供真实交流。衣物词和穿衣动作相连。等待能留出参与机会。选择是邀请，不是服从测试。",
    "refs": ["[6]", "[45]", "[47]", "[82]"]
  },
  "offline": [
    {
      "title": "衣服二选一",
      "minutes": 5,
      "materials": ["两件合适的上衣", "衣物大卡"],
      "steps": [
        "拿对应大卡和真实衣物。并排慢慢说名字。",
        "收好卡片。两件合适上衣放在宝宝前方。",
        "宝宝看、拿或转开都接住。没有选择就由成人选。",
        "穿好后再命名。裤子、袜子、鞋和帽子另天轮换。"
      ],
      "safety": "衣物不能有长绳。检查纽扣和珠片牢固。不留可入口小配件。鞋袜不要过紧。在平稳地面穿衣。不站高处，不强拉四肢。",
      "domains": ["life", "language"],
      "question": "你想怎样帮忙穿衣？",
      "levels": {
        "easier": "只拿出一件衣物，边穿边命名。",
        "harder": "摆两件合适上衣。等目光或手势回应。"
      }
    }
  ],
  "steps": [
    {
      "type": "guide",
      "parentTip": "用真实衣物说词。给宝宝时间参与。",
      "props": {
        "goal": "穿衣时听名字并参与。",
        "materials": ["当天合适的衣物", "衣物打印卡"],
        "steps": [
          {
            "text": "拿大卡与对应衣物并排命名。当天只选一两件。",
            "concept": "shirt",
            "say": {
              "zh": "这是上衣。",
              "en": "This is a shirt."
            }
          },
          {
            "text": "把卡收好。穿袖子时等宝宝伸出手。",
            "concept": "shirt",
            "say": {
              "zh": "小手伸进来。",
              "en": "Put your hand in."
            }
          },
          {
            "text": "拿袜子放在小脚旁。宝宝坐稳再穿。",
            "concept": "socks",
            "say": {
              "zh": "这是袜子。",
              "en": "These are socks."
            }
          },
          {
            "text": "穿好袜子后拿起鞋子。宝宝愿意时帮忙穿鞋。",
            "concept": "shoes",
            "say": {
              "zh": "小脚穿鞋。",
              "en": "Shoes on your feet."
            }
          }
        ],
        "playMin": 5,
        "observe": [
          "是否看向被命名的衣物。",
          "是否伸手、抬脚或等待。",
          "是否能在舒适时参与穿衣。"
        ],
        "safety": "不强迫伸手或抬脚。检查衣物无绳带和小配件。穿衣时成人始终托护宝宝。避免从高处操作。"
      }
    }
  ]
