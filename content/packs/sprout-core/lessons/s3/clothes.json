  "objectives": [
    {
      "zh": "穿衣时听衣物词。",
      "en": "Hear clothing words during dressing."
    },
    {
      "zh": "用伸手、抬脚或看参与。",
      "en": "Join by reaching, lifting a foot, or looking."
    }
