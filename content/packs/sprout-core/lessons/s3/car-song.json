  "parentGuide": {
    "intro": "先学会慢速唱法，关屏后拿出大号玩具车。家长边唱边慢慢推车，唱到“停”时停一下，给宝宝看和回应的机会。",
    "tips": [
      "先唱给宝宝听，不必追求音准。",
      "推车动作慢，留出停顿。",
      "英语只跟唱短句，中文保持自然对话。"
    ],
    "phrases": [
      {
        "zh": "小汽车慢慢开。",
        "en": "The little car goes slowly."
      },
      {
        "zh": "嘀嘀，出发啦。",
        "en": "Beep beep, let's go."
      },
      {
        "zh": "小车停一停。",
        "en": "The car stops."
      },
      {
        "zh": "轮到你推啦。",
        "en": "Your turn to push."
      }
    ],
    "why": "主动唱歌、同步动作和轮流推车，把声音放进真实互动。英语用短句和熟悉旋律输入，不承诺屏幕本身带来语言效果。",
    "refs": ["R50", "R54", "R87", "R88"]
  },
  "offline": [
    {
      "title": "唱歌推小车",
      "minutes": 8,
      "materials": ["大号玩具车", "干净地面"],
      "steps": [
        "家长坐在地上，先唱一遍并慢慢推车。",
        "唱到“嘀嘀”时停一下，看宝宝是否看车。",
        "把车推到宝宝面前，邀请宝宝伸手或轻推。",
        "唱完关掉玩具，和宝宝说“看完啦”。"
      ],
      "safety": "只用没有可拆小零件的大号玩具车；成人全程陪伴，保持地面干净，不把车放在楼梯、桌边或道路上。",
      "domains": ["music", "english", "motor"],
      "question": "小车想开到哪里？",
      "levels": {
        "easier": "家长唱一小句，只做慢慢推车。",
        "harder": "唱到停顿时停住小车，等宝宝用动作回应。"
      }
    }
