  "objectives": [
    {
      "zh": "听汽车词和歌声。",
      "en": "Your baby hears car words and rhythm in a shared song."
    },
    {
      "zh": "用看、推或发声参与。",
      "en": "Your baby joins with a look, push, or sound."
    }
  ],
  "cover": {
    "concept": "toy-car",
    "bg": "paper"
  },
  "parentGuide": {
    "intro": "家长先单独学唱。关屏后拿出大号小车。边唱边慢慢推。唱到停一停就停住。等宝宝看、伸手或发声。没有小车可推布球。",
    "tips": [
      "先唱给宝宝听，不必追求音准。",
      "推车动作慢，留出停顿。",
      "英语只跟唱短句。中文保持自然对话。"
    ],
    "phrases": [
      {
        "zh": "小汽车慢慢开。",
        "en": "The little car goes slowly."
      },
      {
        "zh": "嘀嘀，出发啦。",
        "en": "Beep beep, let's go."
      },
      {
        "zh": "小车停一停。",
        "en": "The car stops."
      },
      {
        "zh": "轮到你推啦。",
        "en": "Your turn to push."
      }
    ],
    "why": "主动音乐研究支持亲子参与。这里把歌声和推车相连。家长接住宝宝的回应。不承诺英语学习效果。",
    "refs": ["[53]", "[82]", "[87]"]
  },
  "offline": [
    {
      "title": "唱歌推小车",
      "minutes": 8,
      "materials": ["大号玩具车", "干净地面"],
      "steps": [
        "家长坐在地上。先唱一遍并慢慢推车。",
        "唱到“嘀嘀”时停一下。看宝宝是否看车。",
        "把车推到宝宝面前。邀请宝宝伸手或轻推。",
        "唱完把小车放好。再说“玩好啦”。"
      ],
      "safety": "只用三岁以下适龄车。小零件不可拆卸。地面干净、防滑。远离楼梯、桌边和道路。成人全程陪伴。防玩具碎裂入口。",
      "domains": ["music", "english", "motor"],
      "question": "小车想开到哪里？",
      "levels": {
        "easier": "家长唱一小句，只做慢慢推车。",
        "harder": "唱到停顿时停住小车。等宝宝用动作回应。"
      }
    }
  ],
