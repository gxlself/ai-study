  "summary": {
    "zh": "家长先学唱。关屏后推真实玩具车。",
    "en": "Learn a car song, then play with a real toy car."
  },
  "ageRange": [12, 17],
  "domains": ["music", "english"],
  "themeId": "s3-t3",
