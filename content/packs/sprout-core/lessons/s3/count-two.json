{
  "schemaVersion": 1,
  "id": "core.s3.count-two",
  "title": {
    "zh": "一、二",
    "en": "One, Two"
  },
  "summary": {
    "zh": "看看手和鞋。一起慢慢数一、二。",
    "en": "Count slowly with everyday pairs such as hands and shoes."
  },
  "ageRange": [12, 17],
  "domains": ["math", "language"],
  "themeId": "s3-t4",
  "tags": ["early-math", "number-talk"],
  "durationMin": 2,
  "coView": "required",
  "audience": "parent",
  "objectives": [
    {
      "zh": "听一、二的生活用语。",
      "en": "Hear one and two in everyday life."
    },
    {
      "zh": "观察点一个、说一个。",
      "en": "Notice one touch for each counting word."
    }
  ],
  "cover": {
    "concept": "num-2",
    "bg": "paper"
  },
  "parentGuide": {
    "intro": "先读完，再关屏。拿两只干净鞋。点一次就说一个数。一、二，两只鞋。不要一、二说成一、两。宝宝只听也好。不要求跟读或按数拿物。",
    "tips": [
      "一次只数一两件。",
      "每个物品只点一次、说一次。",
      "数完马上说“有两只”。帮助宝宝听到总数。"
    ],
    "phrases": [
      {
        "zh": "一只鞋。",
        "en": "One shoe."
      },
      {
        "zh": "两只鞋。",
        "en": "Two shoes."
      },
      {
        "zh": "一、二，一共两只。",
        "en": "One, two, two in all."
      },
      {
        "zh": "慢慢数。",
        "en": "Let's count slowly."
      }
    ],
    "why": "数字谈话有相关证据。不是本课效果的证明。宝宝先听词、看点数。不要求掌握基数原则。",
    "refs": ["[64]", "[65]", "[69]"]
  },
  "offline": [
    {
      "title": "找两只鞋",
      "minutes": 5,
      "materials": ["一双大人的鞋或宝宝的鞋"],
      "steps": [
        "把两只干净鞋并排放好。",
        "点第一只说“一”。点第二只说“二”。",
        "双手框住这两只鞋。再说“两只鞋”。",
        "宝宝有兴趣时换两只手。每个只点一次。"
      ],
      "safety": "鞋子要干净。无松脱小配件和长鞋带。成人全程陪伴。鞋袜不可咬碎入口。小零件要收走。",
      "domains": ["math", "language"],
      "question": "你还发现了哪两个？",
      "levels": {
        "easier": "只数一只鞋，说“一”。",
        "harder": "数两只手或两只袜子。并说出总数。"
      }
    }
  ],
  "steps": [
    {
      "type": "guide",
      "parentTip": "一边点，一边说，数完说总数。",
      "props": {
        "goal": "听一、二，数完听两只鞋。",
        "materials": ["一双鞋", "两只安全的大物品"],
        "steps": [
          {
            "text": "先摆好两只鞋。点第一只。",
            "concept": "num-1",
            "say": {
              "zh": "一。",
              "en": "One."
            }
          },
          {
            "text": "再点第二只鞋。只说一个数字。",
            "concept": "num-2",
            "say": {
              "zh": "二。",
              "en": "Two."
            }
          },
          {
            "text": "双手框住两只鞋。告诉宝宝总数。",
            "concept": "shoes",
            "say": {
              "zh": "一共两只鞋。",
              "en": "Two shoes in all."
            }
          }
        ],
        "playMin": 5,
        "observe": [
          "是否看着家长点数。",
          "是否跟着看第二件物品。",
          "是否对声音或动作有回应。"
        ],
        "safety": "只数大而安全的生活物品。不数小颗食物或小零件。宝宝想拿时。成人先确认物品安全。"
      }
    }
  ]
}
