  "parentGuide": {
    "intro": "先读完，再关屏。当天只选一两张大卡。宝宝看哪张就说哪张。慢慢命名，再学叫声。等一等宝宝的回应。其余动物留到别天。不用一次学完。",
    "tips": [
      "一次只拿一张卡。用真实动物名字。",
      "停五秒左右等回应。不连续问问题。",
      "看、指或咿呀都回应。不要求模仿。",
      "轮换小马和母鸡卡。小马只命名也可以。"
    ],
    "phrases": [
      {
        "zh": "奶牛，哞哞。",
        "en": "Cow, moo moo."
      },
      {
        "zh": "你听到了吗？",
        "en": "Did you hear it?"
      },
      {
        "zh": "轮到你啦。",
        "en": "Your turn."
      },
      {
        "zh": "我听见你了。",
        "en": "I hear you."
      }
    ],
    "why": "儿向语言研究支持真人交流。这里用命名、停顿和回应。不等于本课已证明有效。重点是互动，不是背词。",
    "refs": ["[45]", "[47]", "[82]"]
  },
  "offline": [
    {
      "title": "动物叫声轮流说",
      "minutes": 8,
      "materials": ["农场动物大卡"],
      "steps": [
        "先选一两张卡。拿起宝宝正在看的那张。",
        "说它的名字和叫声。停五秒左右。",
        "宝宝发声时跟着回应。手指哪张就命名哪张。",
        "另一天轮换卡片。慢慢加入小马和母鸡。"
      ],
      "safety": "成人全程拿持大卡。边缘平整，无尖角。纸片破损就收走。不用订书钉或小夹子。3.5厘米以下有窒息风险。较大也需防咬碎入口。不靠近真实动物学叫。",
      "domains": ["language", "science"],
      "question": "你想再听哪个声音？",
      "levels": {
        "easier": "只看一张卡。家长说名字和叫声。",
        "harder": "放两张卡。请宝宝用眼神或手指选一张。"
      }
    }
  ],
  "steps": [
    {
      "type": "guide",
      "parentTip": "先看卡，再放下屏幕陪玩。",
      "props": {
        "goal": "听名字和叫声，等宝宝回应。",
        "materials": ["农场动物打印卡"],
        "steps": [
          {
            "text": "当天先选奶牛卡。若宝宝看别的卡。就说它的名字。",
            "concept": "cow",
            "say": {
              "zh": "奶牛，哞哞。",
              "en": "Cow, moo moo."
            }
          },
          {
            "text": "学当前动物的叫声。奶牛才说哞哞。小猪哼哼，绵羊咩咩。小马只命名也好。",
            "concept": "cow",
            "say": {
              "zh": "再听一听。",
              "en": "Let's listen again."
            }
          },
          {
            "text": "停五秒左右。宝宝发声时跟着回应。",
            "say": {
              "zh": "我听见你了。",
              "en": "I hear you."
            }
          },
          {
            "text": "宝宝还想玩时再换卡。小猪哼哼，绵羊咩咩。小马只命名也好。",
            "concept": "horse",
            "say": {
              "zh": "小马在这儿。",
              "en": "Here is the horse."
            }
          },
          {
            "text": "轮换到母鸡卡时，轻声命名。",
            "concept": "chicken",
            "say": {
              "zh": "母鸡，咯咯。",
              "en": "Hen, cluck cluck."
            }
          }
        ],
        "playMin": 8,
        "observe": [
          "是否看向被命名的卡片。",
          "是否用眼神、手势或声音回应。",
          "是否愿意继续轮流。"
        ],
        "safety": "成人拿卡并陪伴。宝宝转开或想走就停。不强迫模仿或触摸。边缘平整，破损就收走。防止咬碎入口。"
      }
    }
  ]
}
