  "id": "core.s3.wash-hands",
  "title": {
    "zh": "洗手歌",
    "en": "The Hand-Washing Song"
  },
  "summary": {
    "zh": "家长先学唱。关屏后一起洗小手。",
    "en": "Learn a hand-washing song and use it slowly at the sink."
  },
  "ageRange": [12, 17],
  "domains": ["life", "music"],
  "themeId": "s3-t5",
  "tags": ["song", "daily-routine"],
  "durationMin": 3,
  "coView": "required",
  "audience": "parent",
  "objectives": [
    {
      "zh": "听洗手动作词。",
      "en": "Your baby hears action words in the hand-washing routine."
    },
    {
      "zh": "在成人帮助下洗手。",
      "en": "Your baby joins washing and drying with adult help."
    }
  ],
  "cover": {
    "concept": "wash-hands",
    "bg": "sky"
  },
  "parentGuide": {
    "intro": "家长先单独读和学唱。关屏后再洗手。先打湿，再抹肥皂。帮宝宝揉搓至少二十秒。然后冲净、擦干。唱歌不代替计时。八分钟含离水演练。不让宝宝一直玩水。",
    "tips": [
      "成人先试水温。安排熟悉的成人托稳。",
      "搓到手心、手背和指缝。宝宝不必独立做。",
      "水边不看手机。先记好流程再开始。"
    ],
    "phrases": [
      {
        "zh": "小手打湿。",
        "en": "Wet your hands."
      },
      {
        "zh": "擦出泡泡。",
        "en": "Make some bubbles."
      },
      {
        "zh": "冲一冲。",
        "en": "Rinse your hands."
      },
      {
        "zh": "擦干啦。",
        "en": "Dry your hands."
      }
    ],
    "why": "固定常规有助于预期。歌声用于温和陪伴。洗手由成人帮助完成。不用细菌故事吓宝宝。",
    "refs": ["[6]", "[82]", "[87]", "[93]"]
  },
  "offline": [
    {
      "title": "水池边唱洗手歌",
      "minutes": 8,
      "materials": ["肥皂", "毛巾", "稳固的洗手台"],
      "steps": [
        "离开水池做空手演练。家长唱一小段。",
        "需要洗手时再试水温。托稳宝宝并打湿小手。",
        "抹肥皂并轻轻揉搓。至少二十秒。搓到手背和指缝。",
        "用清洁流水冲净。用干净毛巾擦干。离开水池就结束。"
      ],
      "safety": "成人全程一臂之内看护。不让宝宝独自站凳子。不独自接近水池。防滑，先试水温。肥皂不入口、不入眼。水边不要放小物件。",
      "domains": ["life", "music"],
      "question": "洗手时你看到了什么？",
      "levels": {
        "easier": "成人完成全部清洁。宝宝看或伸手就好。",
        "harder": "宝宝愿意时搓一下手。其余由成人帮忙完成。"
      }
    }
  ],
  "steps": [
    {
      "type": "guide",
      "parentTip": "先学唱，之后关屏到水池边做。",
      "props": {
        "goal": "听动作词，在成人帮助下洗手。",
        "materials": ["肥皂", "毛巾", "稳固的洗手台"],
        "steps": [
          {
            "text": "成人先试好水温。托稳宝宝并打湿小手。",
            "concept": "wet-hands",
            "say": {
              "zh": "小手打湿。",
              "en": "Wet your hands."
            }
          },
          {
            "text": "抹肥皂并轻轻揉搓。至少二十秒。含手心、手背和指缝。",
            "concept": "soap",
            "say": {
              "zh": "搓一搓小手。",
              "en": "Rub your hands."
            }
          },
          {
            "text": "用清洁流水冲净泡沫。",
            "concept": "rinse-hands",
            "say": {
              "zh": "冲一冲。",
              "en": "Rinse your hands."
            }
          },
          {
            "text": "用干净毛巾擦干。离开水池。",
            "concept": "towel",
            "say": {
              "zh": "擦干啦。",
              "en": "Dry your hands."
            }
          }
        ],
        "playMin": 8,
        "observe": [
          "是否看向水、泡泡或毛巾。",
          "是否愿意伸手参与。",
          "是否对重复歌声有回应。"
        ],
        "safety": "水边全程看护。不独自站凳子。成人托稳身体。不拽手臂悬空。先检查水温和防滑。肥皂不入口、不入眼。不使用热水或积水盆。宝宝不适时先安抚。再换合适方式清洁。计时是建议陪伴时长。不是玩水时长。"
      }
    },
