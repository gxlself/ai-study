  "parentGuide": {
    "intro": "先读完，再关屏。成人把三张大卡贴好。袜子、鞋子、帽子排开。每次只指当前一步。不是让宝宝记三步指令。帽子按天气选择。不需要时可跳过。",
    "tips": [
      "每次出门都用相似短句。",
      "卡片给家长提示。不让宝宝独自拿卡。",
      "赶时间时只说一两步也可以。"
    ],
    "phrases": [
      {
        "zh": "先穿袜子。",
        "en": "Socks first."
      },
      {
        "zh": "再穿鞋子。",
        "en": "Shoes next."
      },
      {
        "zh": "戴上帽子。",
        "en": "Put on your hat."
      },
      {
        "zh": "我们出门啦。",
        "en": "We are going out."
      }
    ],
    "why": "固定常规帮助建立预期。成人一步一步预告。不要求宝宝记完整流程。这是照护中的交流。",
    "refs": ["[45]", "[82]", "[93]"]
  },
  "offline": [
    {
      "title": "门边流程卡",
      "minutes": 5,
      "materials": ["出门流程卡", "当天要穿的衣物"],
      "steps": [
        "把三张大卡贴好。按袜子、鞋子、帽子排。",
        "每完成一步。家长指卡并说出名称。",
        "邀请摸衣物或抬脚。成人完成穿戴。",
        "出门前检查门、楼梯和道路。再牵护宝宝。"
      ],
      "safety": "卡片由成人管理。小胶片和钉子不可露出。防脱落入口。不在楼梯或高处穿衣。远离门缝，防夹手。出门全程牵护或抱稳。",
      "domains": ["life", "language"],
      "question": "你想怎样帮忙准备出门？",
      "levels": {
        "easier": "只用袜子和鞋子两张卡。",
        "harder": "邀请宝宝递一件衣物。成人伸手并指向它。仍只说一步。"
      }
    }
  ],
  "steps": [
    {
      "type": "guide",
      "parentTip": "卡片给家长提示。真实流程在门边完成。",
      "props": {
        "goal": "用固定短句预告出门流程。",
        "materials": ["出门流程卡", "当天要穿的衣物"],
        "steps": [
          {
            "text": "先指第一张卡，拿起真实袜子。",
            "concept": "socks",
            "say": {
              "zh": "先穿袜子。",
              "en": "Socks first."
            }
          },
          {
            "text": "宝宝抬脚时。成人帮忙穿好袜子。",
            "concept": "socks",
            "say": {
              "zh": "小脚穿袜子。",
              "en": "Socks on your feet."
            }
          },
          {
            "text": "指第二张卡，再拿起鞋子。",
            "concept": "shoes",
            "say": {
              "zh": "再穿鞋子。",
              "en": "Shoes next."
            }
          },
          {
            "text": "最后按天气决定是否戴帽子。再说出门。",
            "concept": "hat",
            "say": {
              "zh": "我们出门啦。",
              "en": "We are going out."
            }
          }
        ],
        "playMin": 5,
        "observe": [
          "是否看向下一张卡或衣物。",
          "是否在穿衣时参与小动作。",
          "是否对固定短句有预期。"
        ],
        "safety": "衣物和卡片由成人管理。检查小配件和过长绳带。防松脱入口。在平稳地面穿衣。出门前确认环境安全。"
      }
    }
  ]
