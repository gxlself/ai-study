  "parentGuide": {
    "intro": "这次学唱开头选段。先由家长单独学唱。再关屏陪宝宝唱。家长先指自己的身体。宝宝可坐着看。愿意动一点也很好。不用唱快，也不用弯腰。",
    "tips": [
      "每个词之间留一点停顿。",
      "先做自己身上的动作。不拉宝宝。",
      "宝宝累了就唱一小段并结束。"
    ],
    "phrases": [
      {
        "zh": "和宝宝一起唱。",
        "en": "Let's sing together."
      },
      {
        "zh": "头，肩膀，膝盖，脚。",
        "en": "Head, shoulders, knees, and toes."
      },
      {
        "zh": "你想做哪个动作？",
        "en": "Which move would you like?"
      },
      {
        "zh": "听完啦。",
        "en": "All done."
      }
    ],
    "why": "音乐研究支持真人参与。不承诺本课的效果。这里用慢歌轮流回应。不用背景播放。",
    "refs": ["[82]", "[87]"]
  },
  "offline": [
    {
      "title": "慢慢唱，轻轻碰",
      "minutes": 8,
      "materials": ["防滑地垫"],
      "steps": [
        "坐在宝宝对面。唱开头选段。指自己的头和肩膀。",
        "再唱一遍。手在腿上轻点膝盖。无需弯腰够脚。",
        "停下来等宝宝回应。看、笑和发声都接住。"
      ],
      "safety": "成人保持稳定坐姿。不快速转动或抛接宝宝。不拉扯手脚。不强迫碰脸。地面保持防滑。",
      "domains": ["music", "motor", "language"],
      "question": "你想怎样跟歌声一起动？",
      "levels": {
        "easier": "只唱开头一小句。宝宝坐着听就好。",
        "harder": "唱开头选段两次。每次停下来等回应。"
      }
    }
  ],
  "steps": [
