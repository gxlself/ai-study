{
  "schemaVersion": 1,
  "id": "core.s3.touch-nose",
  "title": {
    "zh": "摸摸小鼻子",
    "en": "Touch Your Nose"
  },
  "summary": {
    "zh": "听身体词。坐着看、轻轻动都好。",
    "en": "Use simple body actions; your baby may simply watch or smile."
  },
  "ageRange": [12, 17],
  "domains": ["motor", "language"],
  "themeId": "s3-t2",
  "tags": ["body-awareness", "imitation"],
  "durationMin": 2,
  "coView": "required",
  "audience": "parent",
  "objectives": [
    {
      "zh": "听词，观察家长动作。",
      "en": "Hear words and watch your actions."
    },
    {
      "zh": "尝试一个舒适的小动作。",
      "en": "Try one comfortable little action."
    }
  ],
  "cover": {
    "concept": "nose",
    "bg": "paper"
  },
  "parentGuide": {
    "intro": "先读完，再关屏。面对面坐稳。家长先做动作。再停下来等宝宝。宝宝可看、笑或只举一只手。站不稳就坐着动。不要求跺脚或站立。",
    "tips": [
      "先示范，再停下来等宝宝。",
      "动作幅度小而慢。不拉宝宝的手。",
      "不会站或走时。全部动作都可坐着做。"
    ],
    "phrases": [
      {
        "zh": "摸摸鼻子。",
        "en": "Touch your nose."
      },
      {
        "zh": "拍拍肚子。",
        "en": "Pat your belly."
      },
      {
        "zh": "小手举起来。",
        "en": "Raise your hands."
      },
      {
        "zh": "我们慢慢做。",
        "en": "Let's go slowly."
      }
    ],
    "why": "模仿游戏提供来回交流。成人先示范，再等待。宝宝按能力选择动作。不以标准动作判断发育。",
    "refs": ["[6]", "[82]", "[83]"]
  },
  "offline": [
    {
      "title": "身体动作跟一跟",
      "minutes": 5,
      "materials": ["软垫或干净地面"],
      "steps": [
        "家长坐在宝宝对面。先摸自己的鼻子。",
        "邀请拍拍肚子或举手。一次只说一个动作。",
        "宝宝想站且站得稳时。成人在旁扶护。不稳时继续坐着做。"
      ],
      "safety": "地面防滑。远离桌角和硬玩具。收走小物件。不戳鼻孔。不按压肚子和脖子。不拉手。不强迫站立或跺脚。",
      "domains": ["motor", "language"],
      "question": "你想做哪个动作？",
      "levels": {
        "easier": "只做坐着摸鼻子和举手。",
        "harder": "宝宝选一个动作。成人跟着模仿。仍一次只做一个。"
      }
    }
  ],
  "steps": [
    {
      "type": "guide",
      "parentTip": "家长先做，宝宝想跟就跟。",
      "props": {
        "goal": "听身体词，尝试安全的小动作。",
        "materials": ["软垫或干净地面"],
        "steps": [
          {
            "text": "家长先摸自己的鼻子。再停下来。",
            "concept": "nose",
            "say": {
              "zh": "摸摸鼻子。",
              "en": "Touch your nose."
            }
          },
          {
            "text": "轻轻拍拍自己的肚子。等宝宝看你。",
            "concept": "belly",
            "say": {
              "zh": "拍拍肚子。",
              "en": "Pat your belly."
            }
          },
          {
            "text": "慢慢举起双手，再放下双手。",
            "concept": "raise-hands",
            "say": {
              "zh": "小手举起来。",
              "en": "Raise your hands."
            }
          },
          {
            "text": "坐着动动小脚。能独站时可轻踏一次。成人守在身旁。",
            "concept": "foot",
            "say": {
              "zh": "动动小脚。",
              "en": "Move your feet."
            }
          }
        ],
        "playMin": 5,
        "observe": [
          "是否看向家长的动作。",
          "是否尝试一个小动作。",
          "是否在停顿时发声或微笑。"
        ],
        "safety": "按能力选坐姿或站姿。成人近距离保护。不跳跃，不转快圈。不拉扯关节。不强迫站立或跺脚。"
      }
    }
  ]
}
