  "cover": { "concept": "wash-hands", "bg": "room" },
  "parentGuide": {
    "intro": "共看默认关闭，也可由家长学唱。若开启，在干燥处空手模仿。唱完关屏再洗手。搓手至少20秒，家长帮忙。歌长不是洗手或刷牙时长，不能唱完就算洗好了。",
    "tips": ["先唱一段，宝宝只看或动一下都可以。", "真实洗手要搓到手心、手背和指间。", "真刷牙仍由大人完成。", "睡前刷牙不开屏，可直接轻唱。"],
    "phrases": [
      { "zh": "我们一起搓搓手。", "en": "Let's rub our hands together." },
      { "zh": "手心、手背，还有指缝。", "en": "Palms, backs, and between your fingers." },
      { "zh": "冲干净，再擦干。", "en": "Rinse clean, then dry." },
      { "zh": "我帮你轻轻刷。", "en": "I'll brush gently for you." }
    ],
    "why": "音乐以亲子主动参与为主。流程展示后立即转入真实照护。洗手和刷牙细节另见阶段指南官方补充资料。",
    "refs": ["3", "6", "8", "87", "93"]
  },
  "offline": [
    {
      "title": "关屏后一起洗手",
      "minutes": 5,
      "materials": ["清洁流动水", "肥皂或洗手液", "干净毛巾"],
      "steps": ["关屏，成人先调好温和的水。", "湿手，涂皂，帮宝宝搓手。", "手心、手背和指间都搓到。", "搓手至少20秒后冲净。", "用干净毛巾擦干。"],
      "safety": "成人全程贴近看护并控制水温。台面高就由成人安全抱扶，不独自爬凳。肥皂和洗手液不入口、不入眼。不把歌的长度当清洁计时。擦干积水，电器远离水。",
      "domains": ["life", "music"],
      "question": "你想用哪条干净毛巾？",
      "levels": { "easier": "成人帮助完成全部步骤，宝宝伸手参与。", "harder": "宝宝愿意时递毛巾、一起搓手，成人仍负责完整清洁。" }
    },
    {
      "title": "干燥处轻轻梳头",
      "minutes": 3,
      "materials": ["宝宝用的圆滑梳子"],
      "steps": ["坐稳，先告知要梳头。", "成人沿着头发轻轻梳。", "唱一小句，停下来等回应。"],
      "safety": "梳齿圆滑，成人操作。不拉扯打结处，不强迫触摸头部。不含梳子走动。梳子无可拆小件；小物件直径小于3.5厘米有窒息风险。",
      "domains": ["life", "music"],
      "question": "你想先唱，还是先摸摸梳子？",
      "levels": { "easier": "只让宝宝看梳子，成人唱一句。", "harder": "宝宝愿意时递梳子，成人轻柔梳理；不要求自己操作。" }
    }
  ],
