  "objectives": [
    { "zh": "留意图中圆圆的轮廓。", "en": "Notice round outlines in the pictures." },
    { "zh": "用看或指参与短故事。", "en": "Join the short story by looking or pointing." }
  ],
  "cover": { "concept": "circle", "bg": "sky" },
  "printables": [
    { "kind": "cards", "title": "圆圆的朋友卡", "items": ["circle", "sun", "ball", "cookie", "bicycle"], "size": "large", "showText": true, "showEnglish": true }
  ],
  "parentGuide": {
    "intro": "共看默认关闭，可只拿打印卡讲。若开启，读一页就停一下。圆圆是故事里的圆形卡。只比较图中轮廓，不说球就是圆形。讲完关屏，找家里的圆边。",
    "tips": ["只在有提示的页提一个问题。", "宝宝看或指，就说出他关注的物品。", "饼干只说这块，不说所有饼干都圆。"],
    "phrases": [
      { "zh": "图里的太阳圆圆的。", "en": "The sun in the picture looks round." },
      { "zh": "这块饼干也是圆圆的。", "en": "This cookie looks round too." },
      { "zh": "轮子的外边圆圆的。", "en": "The outside of the wheel is round." },
      { "zh": "我们去找一个圆边吧。", "en": "Let's find a round edge nearby." }
    ],
    "why": "简化共读为指认、命名和回应。用眼前圆边连接故事与生活。不把屏幕表现当作形状掌握。",
    "refs": ["3", "6", "8", "15", "48", "67", "71"]
  },
  "offline": [
    {
      "title": "盘子的圆边",
      "minutes": 5,
      "materials": ["圆形不易碎盘", "圆形打印卡", "大皮球"],
      "steps": ["关屏，把盘子和圆形卡放在地上。", "沿盘边慢慢指一圈。", "把卡放在盘旁，比比轮廓。", "摸摸皮球，说它看起来圆圆的。"],
      "safety": "盘子需不易碎、无裂口。大球不能有可脱落小件。小物件直径小于3.5厘米有窒息风险。找轮子用图片，不碰行驶车辆。不直视真实太阳。",
      "domains": ["math", "language"],
      "question": "你想先摸摸哪个圆边？",
      "levels": { "easier": "只看一只圆盘，成人沿边指。", "harder": "加一张方形卡，邀请宝宝给圆卡找相像的轮廓。" }
    }
  ],
