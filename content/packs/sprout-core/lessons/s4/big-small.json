  "parentGuide": {
    "intro": "共看默认关闭，也可只用卡讲故事。若开启，指着物品说大和小。大象和老鼠是玩具故事角色。选择题比较同类图片，避免靠动物名字猜。结束后关屏比真物品。",
    "tips": ["一次只比较两个物品。", "说比旁边这个大或小，不当成固定标签。", "大和小不表示谁更好、谁更厉害。"],
    "phrases": [
      { "zh": "这两个球，一个大，一个小。", "en": "These two balls: one big, one small." },
      { "zh": "这个杯子比旁边的小。", "en": "This cup is smaller than the one beside it." },
      { "zh": "你想先看看哪个？", "en": "Which one would you like to look at first?" },
      { "zh": "大小玩具都可以一起玩。", "en": "We can play with big and small toys together." }
    ],
    "why": "明显差异的比较连到空间词。比较同类物品，减少名字带来的猜测。不要求本月龄独立判断每一轮。",
    "refs": ["3", "6", "8", "67", "71"]
  },
  "offline": [
    {
      "title": "两只碗比一比",
      "minutes": 5,
      "materials": ["两只同形状、大小明显不同的不易碎碗"],
      "steps": ["关屏，把两个碗并排放下。", "分别指着说大一些和小一些。", "把小碗放入大碗，再拿出来。", "请宝宝选一个递给你。"],
      "safety": "两只碗都要足够大、圆滑、不易碎。小物件直径小于3.5厘米有窒息风险。空碗无热水，不扣在宝宝头脸上。成人看护，套放不夹手。",
      "domains": ["math", "language"],
      "question": "你想先拿哪个碗来试试？",
      "levels": { "easier": "只摸两个碗，家长描述大小。", "harder": "交换左右位置，再请宝宝试着找较小的碗。" }
    }
