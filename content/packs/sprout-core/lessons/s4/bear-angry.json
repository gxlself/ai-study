  "parentGuide": {
    "intro": "共看默认关闭，也能用卡讲故事。只在平静时共读，不为止哭开屏。较大的熊是熊妈妈。可换成家中照护者的称呼。呼吸只由大人示范，宝宝不必跟拍。",
    "tips": ["生气是可以有的，不是坏宝宝。", "心情脸是提示图，不要求认出表情。", "不想抱或呼吸，就安静陪着。", "收尾气球只是动画，不拿真气球练呼吸。"],
    "phrases": [
      { "zh": "积木倒了，你生气了。", "en": "The blocks fell. You're angry." },
      { "zh": "我在这里陪着你。", "en": "I'm here with you." },
      { "zh": "想抱抱吗？", "en": "Would you like a hug?" },
      { "zh": "想再搭，还是先休息？", "en": "Build again, or rest first?" }
    ],
    "why": "故事示范接纳情绪和成人陪伴。幼儿的调节仍需要照护者帮助。呼吸不是必做任务，也不保证立即平静。",
    "refs": ["3", "6", "8", "82", "90", "91"]
  },
