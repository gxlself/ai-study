{
  "schemaVersion": 1,
  "id": "core.s2.row-boat",
  "title": {
    "zh": "划船歌",
    "en": "Row Row Row Your Boat"
  },
  "summary": {
    "zh": "家长学会轻柔的划船歌，抱稳宝宝或坐在身边小幅律动。",
    "en": "Learn a gentle rowing song and move safely with your baby."
  },
  "ageRange": [9, 11],
  "domains": ["music", "english", "motor"],
  "themeId": "s2-t4",
  "tags": ["active-music", "rhythm", "co-regulation"],
  "durationMin": 3,
  "coView": "required",
  "audience": "parent",
  "objectives": [
    {
      "zh": "用歌声和轻柔律动和宝宝互动。",
      "en": "Interact through singing and gentle movement."
    },
    {
      "zh": "听见重复的中文和英文节奏。",
      "en": "Hear repeated Chinese and English rhythms."
    }
  ],
  "cover": {
    "concept": "boat",
    "bg": "sea"
  },
  "parentGuide": {
    "intro": "先读指引并关屏，在地面抱稳宝宝，轻轻动一下、停下来回应。后一步旋律只供家长白天学唱，宝宝不在屏幕前；不方便就先结束，择时再学。学会后关屏唱线下版，始终只做很小的律动。",
    "tips": [
      "先确认宝宝坐得稳。",
      "律动幅度小而慢。",
      "唱完停下，不自动重复。",
      "不要求宝宝跟唱；学唱时不让宝宝看屏幕。"
    ],
    "phrases": [
      {
        "zh": "我托着你。",
        "en": "I'm holding you safely."
      },
      {
        "zh": "轻轻划。",
        "en": "Row gently."
      },
      {
        "zh": "和我一起唱。",
        "en": "Sing with me."
      },
      {
        "zh": "划船歌唱完啦。",
        "en": "The rowing song is done."
      }
    ],
    "why": "让歌声围绕成人的目光、动作和回应，而不是背景播放。婴儿主动音乐研究支持共同参与，但不证明这一首歌能促进运动发育。",
    "refs": ["[6]", "[82]", "[87]"]
  },
  "offline": [
    {
      "title": "腿上轻轻摇",
      "minutes": 7,
      "materials": ["地面软垫"],
      "steps": [
        "成人学会旋律后关屏，坐在地面软垫上；宝宝能稳坐时靠在成人腿上，双手托住身体。",
        "唱中文时只让成人身体小幅前后移动一下，再停下来；宝宝不会稳坐就抱稳只唱，不勉强摇动。",
        "宝宝感兴趣才再唱英文，接受看、动或声音回应，随时可以收尾。",
        "歌唱完后保持稳稳抱持，或将宝宝放到安全地垫上休息，不需要反复唱满七分钟。"
      ],
      "safety": "成人坐在平整地垫上，托稳头颈和躯干；不牵手臂拉动、不抛起、上下颠动、快速或大幅摇晃。宝宝不能稳坐时只抱稳唱，不强摆坐姿。远离床沿、沙发边和楼梯；进食时不玩。疲倦、转开或不舒服就停。",
      "domains": ["music", "english", "motor"],
      "question": "宝宝怎样回应你的歌声？",
      "levels": {
        "easier": "抱稳宝宝，只唱一两句，不做律动。",
        "harder": "中文、英文各唱一遍，等宝宝回应再继续；不增加摇动幅度或速度。"
      }
    }
  ],
  "steps": [
    {
      "type": "guide",
      "parentTip": "先关屏抱稳宝宝暖身。后一步只给成人学唱，学会后才用线下版。",
      "props": {
        "goal": "先用稳稳抱持、轻声回应和小幅移动暖身，不会唱也可以。",
        "materials": ["地面软垫"],
        "steps": [
          {
            "text": "先关屏，家长坐在地面软垫上，托稳宝宝的头颈和身体。",
            "concept": "boat",
            "say": {
              "zh": "我托着你。",
              "en": "I'm holding you safely."
            }
          },
          {
            "text": "宝宝能稳坐时靠在成人腿上，成人身体小幅前后动一下，再停下。",
            "say": {
              "zh": "慢慢来。",
              "en": "Nice and slow."
            }
          },
          {
            "text": "等宝宝看、发声或动身体，用轻声回应；不能稳坐就只抱着说话。",
            "say": {
              "zh": "我看见你啦。",
              "en": "I see you."
            }
          },
          {
            "text": "先结束暖身。后面的旋律只给成人学唱，宝宝不在屏幕前；不方便时先结束。",
            "concept": "hug",
            "say": {
              "zh": "先休息啦。",
              "en": "Time for a break."
            }
          }
        ],
        "playMin": 5,
        "observe": [
          "宝宝是否看向家长的脸。",
          "宝宝是否随歌声发声或动身体。",
          "宝宝是否需要更小的律动或更快结束。"
        ],
        "safety": "成人坐在平整地垫上，托稳头颈和躯干；不牵手臂拉动、不抛起、上下颠动、快速或大幅摇晃。宝宝不能稳坐时只抱稳唱，不强摆坐姿。远离床沿、沙发边和楼梯；进食时不玩。疲倦、转开或不舒服就停。"
      }
    },
    {
      "type": "song",
      "parentTip": "仅成人白天学唱；中文一遍再英文一遍，学会后关屏给宝宝唱。",
      "props": {
        "title": {
