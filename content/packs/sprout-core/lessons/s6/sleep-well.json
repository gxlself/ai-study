  "title": { "zh": "好好睡觉", "en": "A Gentle Bedtime Routine" },
  "summary": { "zh": "白天听故事，晚上关屏说晚安。", "en": "Hear the story by day and say goodnight without screens at bedtime." },
  "ageRange": [30, 36],
  "domains": ["life"],
  "themeId": "s6-t5",
  "tags": ["story", "bedtime-routine", "brahms-lullaby", "no-screens-before-bed"],
  "durationMin": 8,
