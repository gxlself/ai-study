  "audience": "child",
  "objectives": [
    { "zh": "认识一个温和的晚安流程。", "en": "Notice a gentle bedtime routine." },
    { "zh": "白天学歌，晚上听家长轻唱。", "en": "Learn the song by day and hear your grown-up sing softly at night." }
  ],
  "cover": { "concept": "bed", "bg": "room" },
  "parentGuide": {
    "intro": "本课只在白天共看，不用屏幕哄睡。故事流程可按家庭习惯调整，不要求每天洗澡。睡前一小时关屏；晚上真人讲书、轻唱即可。睡眠常规不是治疗，也不保证孩子马上睡着。",
    "tips": [
      "保持相近顺序，不机械卡时间。",
      "睡前需要帮助时先回应。",
      "牙膏由成人管理、只用适量；刷牙由成人帮助，不边走边刷。",
      "摇篮曲唱一小段即可，不循环播放。"
    ],
    "phrases": [
      { "zh": "现在慢慢收尾啦。", "en": "We are winding down now." },
      { "zh": "想听哪本书？", "en": "Which book would you like to hear?" },
      { "zh": "我在这里，需要时叫我。", "en": "I am here. Call me if you need me." },
      { "zh": "晚安，明天再玩。", "en": "Goodnight. We can play again tomorrow." }
    ],
    "why": "规律睡前流程与较好的睡眠相关，但多为观察性证据，不承诺疗效。故事和人声可放进无屏常规，屏幕只供白天认识流程。",
    "refs": ["[3]", "[6]", "[92]", "[93]"]
  },
  "offline": [
    {
      "title": "无屏晚安小仪式",
      "minutes": 10,
      "materials": ["当天需要的清洁用品", "儿童牙刷和适量牙膏", "一本纸质图画书"],
      "steps": [
        "白天关屏，约定晚上看哪本书。",
        "晚上按需要清洁，成人帮助刷牙。",
        "坐在一起读几页纸质书。",
        "放好书，调暗灯光，轻声唱。",
        "说晚安，回应孩子的需要。"
      ],
      "safety": "睡前一小时不用屏，不把本课当哄睡播放。洗澡水边成人始终近距离看护，水温由成人检查，地面防滑。牙膏与清洁剂由成人管理，刷牙时不走动。灯具、电线和小夜灯由成人操作；睡眠处防坠落、无缠绕绳带，有持续睡眠困扰咨询医生。",
      "domains": ["life"],
      "question": "你想把哪件安静的事放进晚安流程？",
      "levels": {
        "easier": "只选一本书，成人完成清洁和收尾。",
        "harder": "白天让孩子回顾三步流程，晚上照真实需要进行，不增加入睡任务。"
      }
    }
  ],
