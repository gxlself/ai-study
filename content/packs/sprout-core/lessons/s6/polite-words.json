{
  "schemaVersion": 1,
  "id": "core.s6.polite-words",
  "title": { "zh": "你好、谢谢、再见", "en": "Hello, Thank You, Goodbye" },
  "summary": { "zh": "在真实情境里，听听温柔的话。", "en": "Hear kind words in familiar situations." },
  "ageRange": [30, 36],
  "domains": ["social", "english"],
  "themeId": "s6-t4",
  "tags": ["polite-words", "song", "frere-jacques"],
  "durationMin": 7,
  "coView": "required",
  "audience": "child",
  "objectives": [
    { "zh": "在情境中听问好、感谢和道别。", "en": "Hear greetings, thanks, and goodbyes in context." },
    { "zh": "用话语或手势参与交流。", "en": "Join in with words or gestures." }
  ],
  "cover": { "concept": "wave", "bg": "room" },
  "parentGuide": {
    "intro": "每轮由成人读出三个短句，孩子指选、点头或说话都可以。图标只作提示，不要求认字。家长在生活中自然示范，不逼孩子当众说英语、拥抱或亲吻，也不把礼貌当交换条件。",
    "tips": [
      "先演清情境，再读选项。",
      "问好和再见都能挥手，靠情境区分。",
      "孩子沉默时，成人可以代为表达。",
      "唱完关屏，用玩偶轮流问好。"
    ],
    "phrases": [
      { "zh": "你好！", "en": "Hello!" },
      { "zh": "谢谢你！", "en": "Thank you!" },
      { "zh": "再见啦！", "en": "Bye for now!" },
      { "zh": "请帮帮我。", "en": "Please help me." }
    ],
    "why": "熟悉情境中的真人交流比背词更有意义。家长示范、等待和回应，保留孩子的表达与身体界限；不承诺歌曲带来英语能力。",
    "refs": ["[7]", "[50]", "[53]", "[82]", "[87]"]
  },
  "offline": [
    {
      "title": "玩偶来做客",
      "minutes": 8,
      "materials": ["两个牢固的大玩偶", "一本书"],
      "steps": [
        "关屏，让玩偶相遇并问好。",
        "一个玩偶把书递给另一个。",
        "成人示范谢谢，等待孩子回应。",
        "让玩偶离开，挥手说再见。",
        "交换角色，孩子也可以只做手势。"
      ],
      "safety": "成人全程陪伴，玩偶无可拆小眼睛等小件；直径小于三点五厘米的小物件有窒息风险。不强迫拥抱、亲吻或触碰他人；真实交往中，感谢不代表必须接受礼物或接触。",
      "domains": ["social", "english"],
      "question": "不想说话时，你想怎样表达？",
      "levels": {
        "easier": "只演见面和离开，用挥手回应。",
        "harder": "加入借书情境，让孩子选用请和谢谢。"
      }
    }
  ],
  "steps": [
