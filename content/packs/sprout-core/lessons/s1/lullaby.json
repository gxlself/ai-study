  "cover": { "concept": "moon", "bg": "night" },
  "parentGuide": {
    "intro": "家长白天学旋律，睡前不开屏。临睡前按家里熟悉的顺序，换尿布、穿睡衣，再轻声哼唱。不必唱完，也不保证宝宝马上睡。哭闹时先回应需要，别用音乐盖过哭声。",
    "tips": [
      "每天用相近的短流程，不必卡在同一分钟。",
      "睡前一小时不用屏幕。宝宝平时也不看本课画面。",
      "家长真人轻哼即可，不循环播放或开着计时器哄睡。",
      "困了就收尾。不摇晃、不抛接，不要求自己止哭。"
    ],
    "phrases": [
      { "zh": "换好睡衣啦。", "en": "Your pajamas are on." },
      { "zh": "我在这里。", "en": "I am here." },
      { "zh": "轻轻唱给你听。", "en": "I'll sing softly to you." },
      { "zh": "晚安，宝宝。", "en": "Good night, baby." }
    ],
    "why": "睡前常规研究发现，规律流程与较好的睡眠相关，但不是保证入睡的治疗。家长的轻声回应可融入常规，屏幕不进入睡前安抚。",
    "refs": ["[3]", "[6]", "[92]", "[93]"]
  },
