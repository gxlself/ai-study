{
  "name": "sprout",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "description": "芽芽成长 Sprout — 6 个月到 3 岁的亲子共学大屏课程（电视 / iPad 播放端 + 后台管理 + 插件化内容）",
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r --workspace-concurrency=1 --filter './packages/*' --filter './apps/*' build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "start": "pnpm --filter @sprout/server start",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:route": "tsx scripts/merge-route.ts",
    "content:assets": "tsx scripts/fetch-assets.ts",
    "content:audio": "tsx scripts/gen-audio.ts",
    "content:bundle": "tsx scripts/bundle-pack.ts",
    "content:zip": "tsx scripts/pack-zip.ts",
    "content:all": "tsx scripts/content-all.ts",
    "content:typecheck": "pnpm --dir scripts typecheck",
    "content:test": "pnpm --dir scripts test",
    "qa:license": "node scripts/check-redistributable.mjs",
    "qa:integration": "node scripts/qa-integration.mjs",
    "qa:verify": "node scripts/qa-verify.mjs",
    "qa:report": "node scripts/qa-report.mjs"
  },
  "devDependencies": {
    "@sprout/schema": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "fflate": "^0.8.3",
    "@types/node": "^22.0.0"
  }
}
