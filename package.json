{
  "name": "sprout",
  "private": true,
  "version": "0.1.0",
  "description": "芽芽成长 Sprout — 6 个月到 3 岁的亲子共学大屏课程（电视 / iPad 播放端 + 后台管理 + 插件化内容）",
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r --filter ./packages/* --filter ./apps/* build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "start": "pnpm --filter @sprout/server start",
    "content:validate": "node scripts/validate-content.mjs",
    "content:assets": "node scripts/fetch-assets.mjs",
    "content:audio": "node scripts/gen-audio.mjs"
  },
  "devDependencies": {
    "@sprout/schema": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "fflate": "^0.8.3",
    "@types/node": "^22.0.0"
  }
}
