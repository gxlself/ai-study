<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 家庭服务器 IP 在配对时确定，不能以静态域名列表枚举。只信任系统证书。 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
