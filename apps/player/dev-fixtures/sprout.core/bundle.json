      "id": "core.fixture.word-cards",
      "title": { "zh": "看看苹果和球", "en": "Look Together" },
      "summary": { "zh": "和家长慢慢看两张图，轻声说说名称。", "en": "Look at two pictures together and gently name them." },
      "ageRange": [18, 36],
      "domains": ["language", "english"],
      "tags": ["dev-fixture", "非生产内容"],
      "durationMin": 1,
      "coView": "required",
      "audience": "child",
      "objectives": [{ "zh": "由家长陪同指图与命名，不要求记忆或跟读", "en": "Adult-led pointing and naming without recall or repetition requirements" }],
      "cover": { "concept": "apple", "image": "assets/apple.svg", "bg": "#dff1fb" },
      "parentGuide": {
        "intro": "这是开发演示。请全程陪同，先看苹果，再看球；家长操作翻页，轻声说名称，留时间看孩子的反应。不要求跟读；孩子转头或不想看就结束，关屏后一起玩大号软球。",
        "tips": ["一张图说一句即可，停下来等孩子回应。", "由家长陪同操作，不把注视时长当作能力评估。"],
        "phrases": [{ "zh": "这是苹果。", "en": "This is an apple." }, { "zh": "我们一起看看球。", "en": "Let's look at the ball together." }],
        "why": "让家长和孩子一起看图、说话，不要求识字、记忆或完成指定动作。",
        "refs": []
      },
      "offline": [
        {
          "title": "摸摸大号软球",
          "minutes": 2,
          "materials": ["完整、适龄、无可拆小件的大号软球", "平整地垫"],
          "steps": ["关闭屏幕，由家长拿出软球并说“球”。", "按孩子意愿，让孩子在家长近旁摸一摸，或在地垫上轻轻滚球。", "孩子不感兴趣时结束，不要求完成动作。"],
          "question": "你想怎么和球玩？",
          "levels": {
            "easier": "家长拿着软球说一次名称，孩子可以只看或摸，不要求回应。",
            "harder": "孩子愿意时，和家长在地垫上轮流轻轻滚球，随时可以停。"
          },
          "safety": "成人始终在旁；使用完整适龄玩具，不用小球、气球或可拆小件，不把球放进嘴里；不在楼梯、高处或湿滑地面玩。不需要给孩子拿或吃苹果。",
          "domains": ["language", "motor"]
        }
      ],
      "steps": [
        {
          "type": "word-cards",
          "title": { "zh": "慢慢看两张图", "en": "Look Slowly" },
          "parentTip": "家长操作，等一等；孩子转头就结束，不要求跟读。",
          "props": {
            "items": ["apple", "ball"],
            "show": { "text": true, "english": true, "pinyin": false },
            "speak": "name",
            "autoAdvanceSec": null,
            "intro": { "zh": "我们一起看看。", "en": "Let's look together." }
          }
        }
      ]
    },
