{
  "name": "@sprout/player",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-bundled.mjs",
    "dev": "vite --port 5310",
    "prebuild": "node scripts/copy-bundled.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "prebuild:demo": "SPROUT_LOCAL_AUDIO=0 node scripts/copy-bundled.mjs",
    "build:demo": "tsc -p tsconfig.json && VITE_SPROUT_DEMO=1 vite build --mode demo --outDir dist-demo",
    "postbuild": "node scripts/write-sw-manifest.mjs && node scripts/check-compat.mjs",
    "postbuild:demo": "node scripts/write-sw-manifest.mjs --dist dist-demo && node scripts/check-compat.mjs dist-demo",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run && node --test --test-concurrency=1 scripts/check-compat.test.mjs",
    "test:demo": "node scripts/browser-demo.mjs",
    "check:compat": "node scripts/check-compat.mjs",
    "test:tvcompat": "node scripts/browser-tvcompat.mjs",
    "cap:sync": "cap sync",
    "android:build": "node resources/build-native.mjs android debug",
    "android:release": "node resources/build-native.mjs android release",
    "android:all": "node resources/build-native.mjs android all",
    "android:keygen": "node resources/keygen.mjs",
    "ios:build": "node resources/build-native.mjs ios",
    "native:sync": "node resources/sync-native.mjs",
    "native:assets": "node resources/generate-assets.mjs",
    "native:test": "node --test --test-concurrency=1 resources/tests/*.test.mjs",
    "native:android-smoke": "node resources/android-smoke.mjs",
    "native:ios-smoke": "node resources/ios-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@sprout/activities": "workspace:*",
    "@sprout/core": "workspace:*",
    "@sprout/plugin-sdk": "workspace:*",
    "@sprout/schema": "workspace:*",
    "core-js": "^3.50.0",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "acorn": "^8.18.0",
    "jsdom": "*",
    "postcss": "^8.5.28",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
