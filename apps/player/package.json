{
  "name": "@sprout/player",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-bundled.mjs",
    "dev": "vite --port 5310",
    "prebuild": "node scripts/copy-bundled.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "postbuild": "node scripts/write-sw-manifest.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "cap:sync": "cap sync",
    "android:build": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@sprout/activities": "workspace:*",
    "@sprout/core": "workspace:*",
    "@sprout/plugin-sdk": "workspace:*",
    "@sprout/schema": "workspace:*",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "*",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
